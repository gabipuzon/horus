# Compose reads this file for local configuration and overrides DB/Redis hosts
# with Docker service names. For direct Go runs, export it into the process:
# (set -a; . ./.env; set +a; go run ./cmd/migrate; go run ./cmd/server)
HORUS_DB_HOST=localhost
HORUS_DB_PORT=5432
HORUS_DB_USER=horus
HORUS_DB_PASSWORD=horus
HORUS_DB_NAME=horus

HORUS_REDIS_HOST=localhost
HORUS_REDIS_PORT=6379

HORUS_HTTP_ADDR=:8080
HORUS_WORKER_COUNT=3

# Optional host-side ports for Compose (internal container ports stay fixed).
HORUS_DB_PUBLISH_PORT=5432
HORUS_REDIS_PUBLISH_PORT=6379
HORUS_HTTP_PUBLISH_PORT=8080

# Leave blank to disable Discord incident notifications.
HORUS_DISCORD_WEBHOOK_URL=
